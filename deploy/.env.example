# Copy to .env and fill in. Keep .env private (chmod 600 .env).

# Your domain: the landing page runs on it, the scanners on php2scan.<domain> etc.
DOMAIN=example.ch

# Where the containers listen. 127.0.0.1 = nginx runs on this machine.
# nginx on another machine: this machine's address, e.g. 192.168.1.20
BIND_IP=127.0.0.1

# Address of the proxy whose X-Real-IP header the scanners trust (the visitor's IP).
# nginx on this machine reaches the containers via the compose network's gateway: 172.30.200.1.
# nginx on another machine: that machine's address.
TRUSTED_PROXY=172.30.200.1

# Optional: never check these (comma-separated), e.g. your own servers
DENY_HOSTS=
DENY_IPS=

# Optional: contact section at the bottom of the scanner pages
OPERATOR=
CONTACT=
IMPRINT_URL=

# Optional: access keys. Create one with
#   docker exec -it php2scan python3 web.py --make-key yourname --origin https://example.ch
# and paste the two lines it prints here (only the key's hash is stored).
ACCESS_KEYS=
TRUST_SECRET=
